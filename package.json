{
  "name": "leaflet-tiny-log-collector",
  "version": "1.3.1-dev",
  "bin": "./dist/tlc-main.js",
  "scripts": {
    "start": "ts-node ./src/tlc-main.ts",
    "diststart": "node ./dist/src/tlc-main.js",
    "livereload": "ts-node-dev --respawn --pretty --transpile-only ./src/tlc-main.ts",
    "test": "jest",
    "build": "tsc -p . && tsc-alias -p tsconfig.json && ts-node .circleci/generate-build-time.ts"
  },
  "dependencies": {
    "axios": "1.19.0",
    "config": "4.4.2",
    "js-yaml": "4.3.1",
    "jsonpath-plus": "10.4.0",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/jest": "30.0.0",
    "@types/node": "24.13.3",
    "@types/sinon": "21.0.1",
    "jest": "30.4.2",
    "sinon": "22.1.0",
    "ts-jest": "29.4.12",
    "ts-node": "10.9.2",
    "ts-node-dev": "2.0.0",
    "tsc-alias": "1.9.1",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.9.3"
  }
}
