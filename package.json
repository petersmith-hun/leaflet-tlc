{
  "name": "leaflet-tiny-log-collector",
  "version": "1.2.0-dev",
  "bin": "./dist/tlc-main.js",
  "scripts": {
    "start": "ts-node ./src/tlc-main.ts",
    "diststart": "node ./dist/src/tlc-main.js",
    "livereload": "ts-node-dev --respawn --pretty --transpile-only ./src/tlc-main.ts",
    "test": "jest",
    "build": "tsc -p . && tsc-alias -p tsconfig.json && ts-node .circleci/generate-build-time.ts"
  },
  "dependencies": {
    "axios": "1.7.3",
    "config": "3.3.12",
    "js-yaml": "4.1.0",
    "jsonpath-plus": "10.3.0",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/config": "3.3.5",
    "@types/jest": "29.5.14",
    "@types/node": "22.15.3",
    "@types/sinon": "17.0.4",
    "jest": "29.7.0",
    "sinon": "20.0.0",
    "tsconfig-paths": "4.2.0",
    "tsc-alias": "1.8.15",
    "ts-jest": "29.3.2",
    "ts-node": "10.9.2",
    "ts-node-dev": "2.0.0",
    "typescript": "5.8.3"
  }
}
